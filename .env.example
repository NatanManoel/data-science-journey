# ==============================================================================
# .env.example — MODELO DE VARIÁVEIS DE AMBIENTE (SEGURO PARA O GIT)
# Copie este arquivo para .env e preencha com suas credenciais reais.
# ==============================================================================

# --- LLMs & Provedores de IA (Módulo: APIs & Integração Prática de LLMs) ---
GEMINI_API_KEY="seu_token_aqui"
OPENAI_API_KEY="seu_token_aqui"
ANTHROPIC_API_KEY="seu_token_aqui"
HUGGINGFACE_API_TOKEN="seu_token_aqui"

# --- Embeddings & Vector Stores (ChromaDB / Pinecone) ---
CHROMA_PERSIST_DIRECTORY="./database/chroma_db"
PINECONE_API_KEY="seu_token_aqui"
PINECONE_ENVIRONMENT="gcp-starter"

# --- Aplicação & APIs (FastAPI) ---
APP_ENV="development"
API_HOST="127.0.0.1"
API_PORT=8000
DEBUG=True

# --- Banco de Dados & Engenharia de Dados (Fev/2027) ---
DATABASE_URL="sqlite:///./database/study_tracker.db"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="sua_senha_postgres"
POSTGRES_DB="analytics_mba"
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432

